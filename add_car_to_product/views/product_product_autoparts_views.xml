<odoo>
  <record id="view_product_product_autoparts_form" model="ir.ui.view">
    <field name="name">product.product.form.autoparts</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//form/sheet/notebook" position="inside">
        <page string="Autoparts"
              invisible="not is_autoparts"
              groups="module_name.group_car_user">

          <group>
            <field name="for_all_models"/>
            <field name="oem"/>
          </group>
          <separator string="Compatible Vehicles"/>
          <field name="compatible_vehicle_ids"
                 widget="many2many_tags"
                 options="{'no_create': False}"
          />
        </page>
      </xpath>

      <xpath expr="//field[@name='product_tooltip']" position="after">
        <field name="is_autoparts" readonly="0"/>
        <field name="ovoko_part_id"/>
      </xpath>


    </field>
  </record>

</odoo>